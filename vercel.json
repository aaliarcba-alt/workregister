{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/daily-reminder",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "0 11 * * 5"
    }
  ]
}
